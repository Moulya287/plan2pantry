<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_bg">

    <!-- Warning Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="🔄"
            android:textSize="40sp"
            android:gravity="center"
            android:background="@drawable/circle_orange_bg"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generate New Meal Plan"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"
        android:layout_gravity="center" />

    <!-- Divider -->
    <View
        android:layout_width="50dp"
        android:layout_height="2dp"
        android:background="#341C02"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center" />

    <!-- Message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This will replace your current 7-day meal plan with a brand new one."
        android:textSize="14sp"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your previous meal plan and all progress will be lost."
        android:textSize="14sp"
        android:textColor="#341C02"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Buttons - Fixed alignment -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#757575"
            android:padding="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Yes, Generate"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#341C02"
            android:padding="12dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>