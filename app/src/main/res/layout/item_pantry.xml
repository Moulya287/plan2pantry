<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/transparent_card_bg"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Pantry Icon -->
        <TextView
            android:id="@+id/tv_item_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="📦"
            android:textSize="24sp"
            android:gravity="center" />

        <!-- Item Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Category -->
            <TextView
                android:id="@+id/tv_item_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dairy"
                android:textSize="12sp"
                android:textColor="#341C02"
                android:textStyle="bold" />

            <!-- Item Name -->
            <TextView
                android:id="@+id/tv_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Milk"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <!-- Quantity (below name) -->
            <TextView
                android:id="@+id/tv_item_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 L"
                android:textSize="11sp"
                android:textColor="#341C02"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Used Up Text + Checkbox (Stacked) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <!-- "Used Up" text (like kcal) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Used Up"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#341C02" />

            <!-- Checkbox -->
            <CheckBox
                android:id="@+id/cb_used_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="#E91E63" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>