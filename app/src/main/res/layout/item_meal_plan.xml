<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/transparent_card_bg"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Meal Type Icon/Emoji -->
        <TextView
            android:id="@+id/tv_meal_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🍳"
            android:textSize="24sp"
            android:gravity="center" />

        <!-- Meal Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_meal_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Breakfast"
                android:textSize="12sp"
                android:textColor="#341C02"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_meal_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oats with Banana"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_macros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P:12g  C:60g  F:8g"
                android:textSize="11sp"
                android:textColor="#341C02"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Calories and Checkbox -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_calories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="350 kcal"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#341C02" />

            <CheckBox
                android:id="@+id/check_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#4CAF50" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>