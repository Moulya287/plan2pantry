<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="500dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/dialog_rounded_bg">

        <!-- Food Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:text="🍽️"
                android:textSize="32sp"
                android:gravity="center"
                android:background="@drawable/circle_orange_bg"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log Food"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="6dp"
            android:layout_gravity="center" />

        <!-- Divider -->
        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#341C02"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center" />

        <!-- Food Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food Name"
            android:textSize="12sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_food_name"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="Enter food name"
            android:inputType="text"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edittext_bg_light"
            android:textColor="#333333"
            android:textColorHint="#999999" />

        <!-- Calories -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calories (kcal)"
            android:textSize="12sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_calories"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="Enter calories"
            android:inputType="number"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edittext_bg_light"
            android:textColor="#333333"
            android:textColorHint="#999999" />

        <!-- Protein -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Protein (g)"
            android:textSize="12sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_protein"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="Enter protein"
            android:inputType="numberDecimal"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edittext_bg_light"
            android:textColor="#333333"
            android:textColorHint="#999999" />

        <!-- Carbs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carbs (g)"
            android:textSize="12sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_carbs"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="Enter carbs"
            android:inputType="numberDecimal"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edittext_bg_light"
            android:textColor="#333333"
            android:textColorHint="#999999" />

        <!-- Fats -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fats (g)"
            android:textSize="12sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_fats"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="Enter fats"
            android:inputType="numberDecimal"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edittext_bg_light"
            android:textColor="#333333"
            android:textColorHint="#999999" />

        <!-- Meal Type Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meal Type"
            android:textSize="12sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/sp_meal_type"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/edittext_bg_light"
            android:padding="10dp"
            android:layout_marginBottom="16dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#757575"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Save"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#341C02"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>